# Required
BOT_TOKEN=
ADMIN_ID=

# Optional: AI receipt reading / auto-renewal
GEMINI_API_KEY=
GEMINI_PROXY_URL=
# Optional: channel for the audit trail (receipts, auto-renewal decisions)
LOG_CHANNEL_ID=

# Optional engine settings (normally everything lives in data/xray.json)
# XRAY_AUTO=0            # 0 = do not create Xray clients automatically (manual opt-in in the user card)
# XRAY_CONFIG_PATH=/usr/local/etc/xray/config.json
# SUB_DOMAIN=            # subscription host; overrides "subscription"."domain" of xray.json
# SUB_DIR=               # folder for subscription files
# SUB_PUSH=              # rsync targets, space separated

PYTHONPATH=/opt/xraypanel
