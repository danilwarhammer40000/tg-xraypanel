# /etc/nginx/conf.d/sub-https.conf на ХОСТЕ ПОДПИСОК.
# Замените config.example.net и заголовок профиля (TITLE_B64 = printf 'My VPN' | base64).
# nginx < 1.25.1 (Ubuntu 24.04 ставит 1.24): HTTP/2 включается в listen, директивы "http2 on;" нет.
limit_req_zone $binary_remote_addr zone=subreq:5m rate=30r/m;

server {
    listen 443 ssl http2;
    server_name config.example.net;
    server_tokens off;

    ssl_certificate     /etc/letsencrypt/live/config.example.net/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/config.example.net/privkey.pem;

    root /var/www/sub;

    location / { return 404; }

    # страница с кнопками и профили маршрутизации (не секретные)
    location /routing/ { add_header Cache-Control "no-cache" always; }
    location = /join.html { alias /var/www/sub/routing/join.html; default_type text/html; add_header Cache-Control "no-cache" always; }

    # подписки: отдаются только файлы с именем ровно из 32 hex-символов
    location ~ "^/s/[0-9a-f]{32}$" {
        limit_req zone=subreq burst=20 nodelay;
        default_type text/plain;
        add_header Profile-Title "base64:TITLE_B64" always;
        add_header Profile-Update-Interval "1" always;
        add_header Cache-Control "no-store" always;
        # профиль маршрутизации (заголовки autorouting и routing) пишет gen_routing.py;
        # маска не даёт ошибки, пока файла ещё нет
        include /etc/nginx/snippets/sub-routing-*.conf;
        try_files $uri =404;
    }
}
